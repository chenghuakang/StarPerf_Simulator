def h5_to_dict(obj):
    d = {}
    for attr_name, attr_value in obj.attrs.items():
        if isinstance(attr_value, np.ndarray):
            d[f"attr_{attr_name}"] = attr_value.tolist()
        elif isinstance(attr_value, bytes):
            d[f"attr_{attr_name}"] = attr_value.decode('utf-8')
        else:
            d[f"attr_{attr_name}"] = attr_value

    for key, item in obj.items():
        if isinstance(item, h5py.Group):
            d[key] = h5_to_dict(item)
        elif isinstance(item, h5py.Dataset):
            value = item[()]
            if isinstance(value, np.ndarray):
                d[key] = value.tolist()
            elif isinstance(value, bytes):
                d[key] = value.decode('utf-8')
            else:
                d[key] = value
    return d

def h5_to_json(h5_path, json_path):
    try:
        with h5py.File(h5_path, 'r') as f:
            data = h5_to_dict(f)
            
        with open(json_path, 'w') as jf:
            json.dump(data, jf, indent=10)
        print(f"Successfully converted {h5_path} to {json_path}")
        
        print("\nGenerated Dictionary Structure:")
        pprint.pprint(data, depth=5)
        
    except Exception as e:
        print(f"Error during conversion: {e}")

def convert_and_generate(xml_path):
    tree = ET.parse(xml_path)
    root = tree.getroot()
    
    config_data = {
        "Shells": [{
            "altitude": float(root.find('shell1/altitude').text),
            "orbit_cycle": int(root.find('shell1/orbit_cycle').text),
            "inclination": float(root.find('shell1/inclination').text),
            "phase_shift": int(root.find('shell1/phase_shift').text),
            "number_of_orbit": int(root.find('shell1/number_of_orbit').text),
            "number_of_satellite_per_orbit": int(root.find('shell1/number_of_satellite_per_orbit').text)
        }]
    }

    temp_config = "config/temp_params.json"
    with open(temp_config, 'w') as f:
        json.dump(config_data, f, indent=10)
    
    orbit_configuration(xml_path)

