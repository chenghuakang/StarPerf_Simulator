{
  "node-config-common": [
    {
      "match-key": "type",
      "match-value": "satellite",
      "config-common": {
        "type": "undefined",
        "n_antennas": 2,
        "metadata": {},
        "image": "msvcbench/sat-container:latest",
        "sidecars": [],
        "cpu-request": "100m",
        "mem-request": "200MiB",
        "L3-config": {
          "enable-netem": true,
          "enable-routing": true,
          "routing-module": "extra.routing.isis",
          "routing-metadata": {
            "isis-area-id": "0001",
            "advertize-default-route": false
          },
          "auto-assign-ips": true,
          "auto-assign-super-cidr": [
            {
              "match-key": "type",
              "match-value": "satellite",
              "super-cidr": "172.100.0.0/16"
            }
          ]
        }
      }
    },
